rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function astipUser() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@astip\\.cz$');
    }

    match /sitesUnified/{docId} {
      allow read, write: if astipUser();
    }

    match /sitesUnified/{docId}/{subPath=**} {
      allow read, write: if astipUser();
    }

    match /technicianSignatures/{docId} {
      allow read, write: if astipUser();
    }

    match /technician_signatures/{docId} {
      allow read, write: if astipUser();
    }

    match /technicians/{docId} {
      allow read, write: if astipUser();
    }

    match /siteEdits/{docId} {
      allow read, write: if astipUser();
    }

    match /sites/{docId} {
      allow read, write: if astipUser();
    }

    match /deletedSites/{docId} {
      allow read, write: if astipUser();
    }

    match /serviceRecords/{docId} {
      allow read, write: if astipUser();
    }

    match /protocols/{docId} {
      allow read, write: if astipUser();
    }
  }
}
